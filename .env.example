# Dedicated DengueSense PostGIS (do not reuse the other project's database).
# Inside Compose, DB_HOST must stay "postgres" (the service name). Host port is 5433.

DB_HOST=postgres
DB_PORT=5432
DB=denguesense
DB_USERNAME=denguesense
DB_PASSWORD=change-me

FRONTEND_URL=https://your-frontend.example

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — leave blank to start the API without these services
AI_SERVICE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=denguesensebot
AUTH2_CLIENT_ID=
AUTH2_SECRET=
SES_SMTP=
SES_USERNAME=
SES_PASSWORD=
FROM_EMAIL=
FIREBASE_CREDENTIALS_FILE=
FORECAST_SCHEDULER_CRON=0 0 2 * * MON
